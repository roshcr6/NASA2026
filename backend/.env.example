# SPHEREx Sky Explorer — environment configuration
# Copy this file to .env and fill in values as needed.
# NEVER commit .env to version control.

# Preferred data release (spherex_qr3 or spherex_qr2)
PREFERRED_RELEASE=spherex_qr3
FALLBACK_RELEASE=spherex_qr2

# CORS — comma-separated allowed origins for the frontend
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cache directory for generated previews
CACHE_DIR=cache

# Max concurrent IRSA requests (tune to service guidance)
MAX_CONCURRENT_REQUESTS=6

# HTTP timeout in seconds
HTTP_TIMEOUT=30.0

# Max cutout size in degrees
MAX_CUTOUT_DEG=0.5

# Default cutout size
DEFAULT_CUTOUT_DEG=0.1

# Enable OpenAPI docs (set false in production)
DEBUG=true
